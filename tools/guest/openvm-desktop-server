#!/bin/sh
# The guest's X server: real Xorg on the virtio-gpu display when there is one,
# because that is what follows the host's resolution. A VM started without a
# display device falls back to Xvfb.
for module in virtio-gpu virtio_snd xhci-pci usbhid hid-generic evdev; do
    modprobe "$module" 2>/dev/null
done
i=0
while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 20 ]; do
    sleep 0.1
    i=$((i + 1))
done
[ -e /dev/dri/card0 ] || exec /usr/bin/Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp -ac

# USB enumeration trails the module load, one device at a time. The input devices
# are listed statically because the guest has no udev for Xorg to hot-plug them
# from, so a device that arrives late is lost: wait for the keyboard and the pointer.
i=0
while [ "$(ls /dev/input/event* 2>/dev/null | wc -l)" -lt 2 ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
conf=/run/openvm-xorg.conf
cat /opt/openvm/openvm-xorg.conf > "$conf"
n=0
inputs=
for device in /dev/input/event*; do
    [ -e "$device" ] || continue
    n=$((n + 1))
    printf 'Section "InputDevice"\n    Identifier "input%s"\n    Driver "evdev"\n    Option "Device" "%s"\nEndSection\n\n' "$n" "$device" >> "$conf"
    inputs="$inputs    InputDevice \"input$n\"\n"
done
printf 'Section "ServerLayout"\n    Identifier "openvm"\n%bEndSection\n' "$inputs" >> "$conf"
exec /usr/bin/Xorg :99 -nolisten tcp -ac -noreset -config "$conf" vt7
